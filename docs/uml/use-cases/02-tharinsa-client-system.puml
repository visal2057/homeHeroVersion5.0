@startuml Module2-Client-System
' ============================================================
' Module 2 - Client System
' Owner: Tharinsa
' Ref: System Flow v4 - Sections 4, 10-19, 52.2, 52.3
' ============================================================

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #4A5568
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor #EBF4FF
  BorderColor #2B6CB0
  FontColor #1A202C
}
skinparam rectangle {
  BackgroundColor #F7FAFC
  BorderColor #2D3748
  FontStyle bold
}
skinparam actor {
  BackgroundColor #FEEBC8
  BorderColor #C05621
}

title Module 2 - Client System (Tharinsa)

actor "Visitor" as VIS
actor "Client" as CLI

rectangle "Client Module" {

  usecase "Browse Landing Page" as UC1
  usecase "View Public Content Pages\n(About / Careers / Contact)" as UC2
  usecase "Submit Contact Form" as UC3

  usecase "Explore Service Category" as UC4
  usecase "View Top Five Providers" as UC5
  usecase "Search Provider by Name" as UC6
  usecase "Filter Providers by District" as UC7
  usecase "Preview Previous Work" as UC8
  usecase "View Provider Public Profile" as UC9
  usecase "View Portfolio Posts" as UC10
  usecase "View Provider Reviews" as UC11

  usecase "Create Booking Request" as UC12
  usecase "Select Booking Location" as UC13
  usecase "Upload Job Photos" as UC14
  usecase "Validate Provider Availability" as UC15
  usecase "Redirect to Client Registration" as UC16

  usecase "View My Bookings" as UC17
  usecase "View Requests Tab" as UC18
  usecase "View Jobs To Do Tab" as UC19
  usecase "View Completed Jobs Tab" as UC20
  usecase "Cancel Booking" as UC21
  usecase "Respond to Reschedule Proposal" as UC22
  usecase "Start Pay and Review" as UC23
  usecase "Download Invoice" as UC24

  usecase "Manage Client Profile" as UC25
  usecase "Update Primary / Secondary Location" as UC26
  usecase "Change Password" as UC27
  usecase "Change Profile Picture" as UC28

  usecase "Submit Complaint" as UC29
  usecase "Identify Other Party from Booking ID" as UC30
  usecase "Select Complaint Type" as UC31

  usecase "View Notifications" as UC32
  usecase "View Announcements" as UC33
  usecase "View Personal Notifications" as UC34
  usecase "Mark Notification as Read" as UC35
}

' --- Actor associations -------------------------------------
VIS --> UC1
VIS --> UC2
VIS --> UC4
VIS --> UC9

CLI --> UC1
CLI --> UC2
CLI --> UC3
CLI --> UC4
CLI --> UC9
CLI --> UC12
CLI --> UC17
CLI --> UC21
CLI --> UC22
CLI --> UC23
CLI --> UC24
CLI --> UC25
CLI --> UC29
CLI --> UC32

' --- Relationships -----------------------------------------
UC2 ..> UC3 : <<extend>>

UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<extend>>
UC4 ..> UC7 : <<extend>>
UC4 ..> UC8 : <<extend>>
UC4 ..> UC9 : <<extend>>
UC9 ..> UC10 : <<include>>
UC9 ..> UC11 : <<include>>

UC12 ..> UC13 : <<include>>
UC12 ..> UC14 : <<include>>
UC12 ..> UC15 : <<include>>
UC16 ..> UC12 : <<extend>>

UC17 ..> UC18 : <<include>>
UC17 ..> UC19 : <<include>>
UC17 ..> UC20 : <<include>>
UC21 ..> UC18 : <<extend>>
UC23 ..> UC19 : <<extend>>
UC24 ..> UC20 : <<extend>>

UC25 ..> UC26 : <<include>>
UC25 ..> UC27 : <<include>>
UC25 ..> UC28 : <<include>>

UC29 ..> UC30 : <<include>>
UC29 ..> UC31 : <<include>>

UC32 ..> UC33 : <<include>>
UC32 ..> UC34 : <<include>>
UC32 ..> UC35 : <<extend>>
UC22 ..> UC34 : <<extend>>

legend bottom
  |= Use case |= Note / integration point |
  | Redirect to Client Registration | Visitors may browse and view profiles, but Book Now redirects to registration (Dinuka). |
  | Start Pay and Review | Hands the booking over to Visal's Payments module (cash / card + review). |
  | Download Invoice | Displays the invoice PDF generated by Dinuka's module - the Client never generates one. |
  | Respond to Reschedule Proposal | Accept / Reject shown inline in the notification bell; proposal comes from Maheli's module. |
  | Identify Other Party from Booking ID | v3 change: complaints are booking-first; the token is now optional. |
endlegend

@enduml
